# Proxy HTTPS delante del servidor de Shinji SOC (contenedor "caddy").
#
# Dos modos, segun el .env:
#   - Red local (por defecto): PANEL_ADDRESS="localhost, 192.168.1.10" y
#     PANEL_TLS="tls internal". Caddy firma con su propia CA; hay que
#     instalar su certificado raiz en los navegadores y en los agentes
#     (ver README, seccion HTTPS).
#   - Dominio publico: PANEL_ADDRESS="panel.midominio.com" y
#     PANEL_TLS="tls tu@correo.com". Certificado de Let's Encrypt
#     automatico; el dominio tiene que apuntar a este servidor y los
#     puertos 80 y 443 tienen que llegar desde internet.
#
# Las variables {$VAR:defecto} se reemplazan antes de leer este archivo
# (https://caddyserver.com/docs/caddyfile/concepts). Los streams
# text/event-stream (eventos en vivo del panel) se reenvian sin buffer
# (https://caddyserver.com/docs/caddyfile/directives/reverse_proxy).

{
	# Quien se conecta por IP (los agentes) no manda SNI: por norma, TLS no
	# lo permite para IPs. Sin esto Caddy no sabe que certificado mostrar y
	# corta con "internal error". Poner aca la IP con la que se conectan.
	default_sni {$PANEL_DEFAULT_SNI:localhost}
}

{$PANEL_ADDRESS:localhost} {
	{$PANEL_TLS:tls internal}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	reverse_proxy server:8000
}
