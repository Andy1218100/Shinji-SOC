# Base de datos
POSTGRES_USER=proxsecure
POSTGRES_PASSWORD=change-me
POSTGRES_DB=proxsecure

# IA local (Ollama, corre como contenedor)
OLLAMA_MODEL=qwen2.5:3b

# IA en la nube (opcional). Dejar vacio para usar solo Ollama.
ANTHROPIC_API_KEY=
AI_BACKEND=ollama

# Clave usada por el panel/admin API para crear hosts y reglas
ADMIN_API_KEY=change-me-admin-key

# GeoIP para el mapa de ataques. Cuenta gratuita + license key en
# https://www.maxmind.com/en/geolite2/signup, luego: scripts/update_geoip_db.sh
MAXMIND_LICENSE_KEY=
