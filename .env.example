# Base de datos
POSTGRES_USER=shinjisoc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shinjisoc

# IA local (Ollama, corre como contenedor)
OLLAMA_MODEL=qwen2.5:3b

# IA en la nube (opcional). Dejar vacio para usar solo Ollama.
ANTHROPIC_API_KEY=
AI_BACKEND=ollama

# Firma las cookies de sesion del dashboard (login con usuario+contrasena+MFA).
# Generar con: openssl rand -hex 32
SESSION_SECRET_KEY=change-me-session-secret
# true solo si el dashboard esta detras de HTTPS (produccion real).
SESSION_COOKIE_SECURE=false

# GeoIP para el mapa de ataques. Cuenta gratuita + license key en
# https://www.maxmind.com/en/geolite2/signup (Account ID = numero que
# aparece arriba a la izquierda en tu cuenta), luego: scripts/update_geoip_db.sh
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
