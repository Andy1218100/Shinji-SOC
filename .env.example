# Base de datos
POSTGRES_USER=proxsecure
POSTGRES_PASSWORD=change-me
POSTGRES_DB=proxsecure

# IA local (Ollama, corre como contenedor)
OLLAMA_MODEL=llama3.1:8b

# IA en la nube (opcional). Dejar vacio para usar solo Ollama.
ANTHROPIC_API_KEY=
AI_BACKEND=ollama

# Clave usada por el panel/admin API para crear hosts y reglas
ADMIN_API_KEY=change-me-admin-key
