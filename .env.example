# Shinji SOC: configuracion del servidor.
# Copialo a .env (cp .env.example .env) y cambia al menos las lineas
# marcadas con OBLIGATORIO. Todo lo de la seccion "Ajustes" tambien se
# cambia despues desde el panel (Configuracion), sin editar este archivo.
# Guia completa: docs/INSTALACION.md

# --- Base de datos (solo se cambian aqui) ---------------------------------
POSTGRES_USER=shinjisoc
# OBLIGATORIO: una contrasena larga. Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shinjisoc

# --- Sesiones -------------------------------------------------------------
# OBLIGATORIO: firma las cookies de sesion. Generar con: openssl rand -hex 32
SESSION_SECRET_KEY=change-me-session-secret
# true cuando el panel se usa solo por HTTPS (paso 7 del manual). Con true,
# por HTTP no se puede iniciar sesion.
SESSION_COOKIE_SECURE=false

# --- Red y HTTPS (contenedor caddy) ---------------------------------------
# Puerto 8000 sin cifrar: 0.0.0.0 lo deja abierto en la red; 127.0.0.1 solo
# para este equipo (recomendado cuando todo use HTTPS).
SERVER_BIND=0.0.0.0
# Nombres o IPs con los que se abre el panel por HTTPS, separados por coma.
PANEL_ADDRESS=localhost
# "tls internal" = certificado de una CA propia de Caddy (red local).
# "tls tu@correo.com" = certificado de Let's Encrypt (dominio publico).
PANEL_TLS=tls internal
# IP o nombre con el que se conectan los agentes (ver docs/INSTALACION.md).
PANEL_DEFAULT_SNI=localhost

# --- IA -------------------------------------------------------------------
# ollama = IA local en este servidor (por defecto, sin enviar datos afuera).
# claude = API de Anthropic, necesita ANTHROPIC_API_KEY.
AI_BACKEND=ollama
OLLAMA_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Token para auditar la IA local con Claude Code (tools/mcp_audit). Vacio =
# apagado. Se genera desde Configuracion.
AUDIT_API_TOKEN=

# --- Mapa de ataques (opcional) -------------------------------------------
# Cuenta gratuita en https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- Ajustes (tambien se cambian desde Configuracion) ---------------------
# Notificaciones: un canal sin datos no se usa.
NOTIFY_MIN_SEVERITY=critical
NOTIFY_VULNS=true
NOTIFY_INCLUDE_IPS=false
NOTIFY_COOLDOWN_SECONDS=600
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_URL=
NTFY_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Deteccion de intrusos
IDS_WINDOW_SECONDS=60
IDS_REQUESTS_THRESHOLD=50
IDS_404_THRESHOLD=15
SSH_FAIL_THRESHOLD=5
SSH_WINDOW_SECONDS=600

# Tareas periodicas
VULN_SCAN_INTERVAL_SECONDS=86400
ALERT_EVAL_INTERVAL_SECONDS=30

# Retencion (dias) y respaldos
RETENTION_METRICS_DAYS=30
RETENTION_REQUESTS_DAYS=7
RETENTION_EVENTS_DAYS=365
RETENTION_RESOLVED_DAYS=90
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Inicio de sesion
SESSION_MAX_AGE_SECONDS=86400
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
